-def _chunked_prefill_enabled(
+def chunked_prefill_enabled(
     model,
     *,
     input_ids=None,
@@ -34,6 +34,14 @@ def _chunked_prefill_enabled(
     draft_kind=None,
     prefill_kwargs=None,
 ) -> bool:
+    """Whether prefill will be chunked for this model and this call.
+
+    The answer is not just the step size: a model can decline chunking through
+    ``chunked_prefill_policy`` or ``no_chunked_prefill``, and supplying a draft
+    model turns it off for any model that does not declare a policy, since
+    hidden-state speculative prefill depends on a contract the target may not
+    have. Callers that need to know which path ran have no other way to ask.
+    """
     prefill_kwargs = prefill_kwargs or {}
     candidates = [model]
     language_model = getattr(model, "language_model", None)
