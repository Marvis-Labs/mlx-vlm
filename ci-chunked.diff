+def test_chunked_prefill_enabled_is_part_of_the_public_surface():
+    """Three subsystems import it, so it cannot stay private by name."""
+    from mlx_vlm.generate import ar, common, diffusion
+    from mlx_vlm.server import generation
+
+    assert callable(common.chunked_prefill_enabled)
+    for module in (ar, diffusion, generation):
+        assert module.chunked_prefill_enabled is common.chunked_prefill_enabled
+
+
+def test_a_draft_model_turns_chunked_prefill_off():
+    """Hidden-state speculative prefill needs a contract the target may not have."""
+    from unittest.mock import MagicMock
+
+    from mlx_vlm.generate.common import chunked_prefill_enabled
+
+    model = MagicMock(spec=[])
+    assert chunked_prefill_enabled(model, draft_model=None)
+    assert not chunked_prefill_enabled(model, draft_model=MagicMock())
